# Maintainer: Antti Linno <antti.linno@gmail.com>
pkgname=goto-bin
pkgver=1.9.2
pkgrel=1
pkgdesc="Shell utility for navigating to aliased directories"
arch=('x86_64')
url="https://github.com/anttilinno/goto"
license=('MIT')
provides=('goto')
conflicts=('goto')
optdepends=('fzf: interactive alias selection')
source=("goto-bin-${pkgver}::${url}/releases/download/v${pkgver}/goto-bin-x86_64-unknown-linux-gnu"
        "goto.bash-${pkgver}::${url}/raw/v${pkgver}/shell/goto.bash"
        "goto.zsh-${pkgver}::${url}/raw/v${pkgver}/shell/goto.zsh"
        "goto.fish-${pkgver}::${url}/raw/v${pkgver}/shell/goto.fish")
sha256sums=('0019dfc4b32d63c1392aa264aed2253c1e0c2fb09216f8e2cc269bbfb8bb49b5'
            'fba4892d717de8fda6bb3d960845d4583710eb991bb36c5866dd87b19ee2fbe0'
            'f4109b5a2b1b85cc79178e72ddbfe2db52f5656656121b333137ed5ca89d14ed'
            '85b86209e6923fb023bfc54094c6a83bcff747be5a53063637206b1876f48a39')

package() {
    # Install binary
    install -Dm755 "goto-bin-${pkgver}" "${pkgdir}/usr/bin/goto-bin"

    # Install shell integration files
    install -Dm644 "goto.bash-${pkgver}" "${pkgdir}/usr/share/goto/goto.bash"
    install -Dm644 "goto.zsh-${pkgver}" "${pkgdir}/usr/share/goto/goto.zsh"
    install -Dm644 "goto.fish-${pkgver}" "${pkgdir}/usr/share/goto/goto.fish"
}
